# Relais HTTPS : certificat Let's Encrypt obtenu et renouvelé automatiquement
# pour le domaine (variable DOMAIN), redirection http -> https incluse.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy frontend:80
}

# Adresse www -> adresse principale
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
