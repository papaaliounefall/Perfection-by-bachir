# Copier vers frontend/.env.local puis adapter.

# Backend Django utilisé par le proxy de développement (npm run dev)
BACKEND_URL=http://localhost:8000

# Coordonnées officielles de l'atelier — laissées vides tant qu'elles ne sont
# pas validées par l'entreprise (les blocs correspondants sont alors masqués).
VITE_BUSINESS_PHONE=
VITE_BUSINESS_WHATSAPP=
VITE_BUSINESS_ADDRESS=
