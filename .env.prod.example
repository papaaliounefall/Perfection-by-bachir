# Production — copier vers .env SUR LE SERVEUR puis remplir. Ne jamais versionner .env.

# Nom de domaine (sans https://), son DNS doit pointer vers l'adresse IP du serveur
DOMAIN=

# Clé secrète Django : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Mot de passe de la base (long et aléatoire)
POSTGRES_PASSWORD=

# Envoi des emails (notifications, mot de passe oublié) — fourni par le prestataire SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Perfection <no-reply@exemple.com>

# Identité imprimée sur les factures
BUSINESS_NAME=Perfection By Bachir Ndour
BUSINESS_ADDRESS=Dakar, Sénégal
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_NINEA=

# Coordonnées affichées sur le site (vides = masquées)
BUSINESS_WHATSAPP=
BUSINESS_ADDRESS_PUBLIC=

WORKSHOP_CAPACITY=2
BACKUP_KEEP_DAYS=14
