# Copier vers backend/.env puis adapter. Ne jamais versionner le fichier .env.

DJANGO_DEBUG=true
# Obligatoire hors DEBUG : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines de confiance pour le CSRF (URL du frontend en production)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# PostgreSQL : décommenter après "docker compose up -d".
# Tant que POSTGRES_DB est absent, SQLite est utilisé (développement uniquement).
# POSTGRES_DB=perfection
# POSTGRES_USER=perfection
# POSTGRES_PASSWORD=perfection
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Cookies sécurisés (à activer en production derrière HTTPS)
DJANGO_SECURE_COOKIES=false

# Atelier
WORKSHOP_CAPACITY=2

# Emails de notification. En développement : affichés dans la console.
# En production (SMTP) :
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.exemple.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_DEFAULT_FROM_EMAIL=Perfection <no-reply@exemple.com>
